# Sem DATABASE_URL: PostgreSQL embutido no servidor.
# Windows: %LOCALAPPDATA%/WhatIsTheSyntax/<projeto>/pglite; demais sistemas: .data/pglite.
# Em produção, DATABASE_URL é obrigatória. Use a conexão/pooler do PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
LOCAL_DATABASE_DIR=
PORT=3001
APP_ORIGIN=http://localhost:5173
# URL e chave PUBLICÁVEL do mesmo projeto Supabase. Nunca use service_role aqui.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Conta de revisão local. NODE_ENV=production sempre desativa esta opção.
LOCAL_DEMO_AUTH=true
# Use apenas atrás de um proxy conhecido; 0 para acesso direto.
TRUST_PROXY_HOPS=0
